<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sets the Workshop item's tags, which SteamCMD cannot do. Uses the game's own Steamworks.NET. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(GameDir)\Probably Stolen_Data\Managed\com.rlabrecque.steamworks.net.dll" />
    <None Include="$(GameDir)\Probably Stolen_Data\Plugins\x86_64\steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
